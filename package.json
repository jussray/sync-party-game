{
  "name": "sync-party-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "bugfinder": "python3 scripts/bugfinder.py",
    "verify:asset-continuity": "node scripts/verify-asset-continuity.mjs",
    "verify:asset-continuity:release": "node scripts/verify-asset-continuity.mjs --release",
    "verify": "npm test && npm run bugfinder && npm run verify:asset-continuity"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "wrangler": "4.135.0"
  }
}
